# These are provided automatically once you attach the Neon integration to
# your Vercel project (Vercel Dashboard -> your project -> Storage tab ->
# Connect Database -> Neon). You do not need to fill these in by hand for
# production — Vercel injects them.
#
# For local development with Neon or any Postgres-compatible database,
# create a .env.local or .env.development.local file and set DATABASE_URL.
# Example:
#   DATABASE_URL=postgres://postgres:password@localhost:5432/harborjobs
#
# If you use Vercel locally, you can also run:
#   vercel link
#   vercel env pull .env.development.local
# which downloads the values automatically into a git-ignored file.

DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Adzuna: India job listings (free key: https://developer.adzuna.com/) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Google Sign-In (create at https://console.cloud.google.com/apis/credentials) ---
# Authorized redirect URI to add there: https://YOUR-DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- NextAuth ---
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://YOUR-DOMAIN

# Comma-separated list of emails that should get admin access
ADMIN_EMAILS=you@gmail.com

# --- Razorpay: payments (keys at https://dashboard.razorpay.com/app/keys) ---
# Payouts land in whatever bank account you verify with Razorpay's own KYC
# (PAN + bank details) directly on their dashboard — that step can't be done
# through code, it's how they prevent fraud/money laundering.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Job posting fee in INR, whole rupees (e.g. 499)
JOB_POST_FEE_INR=499
